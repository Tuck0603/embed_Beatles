--cpu Cortex-M3
"encoderoled\startup_stm32f103xe.o"
"encoderoled\main.o"
"encoderoled\gpio.o"
"encoderoled\spi.o"
"encoderoled\usart.o"
"encoderoled\stm32f1xx_it.o"
"encoderoled\stm32f1xx_hal_msp.o"
"encoderoled\stm32f1xx_hal_gpio_ex.o"
"encoderoled\stm32f1xx_hal_spi.o"
"encoderoled\stm32f1xx_hal.o"
"encoderoled\stm32f1xx_hal_rcc.o"
"encoderoled\stm32f1xx_hal_rcc_ex.o"
"encoderoled\stm32f1xx_hal_gpio.o"
"encoderoled\stm32f1xx_hal_dma.o"
"encoderoled\stm32f1xx_hal_cortex.o"
"encoderoled\stm32f1xx_hal_pwr.o"
"encoderoled\stm32f1xx_hal_flash.o"
"encoderoled\stm32f1xx_hal_flash_ex.o"
