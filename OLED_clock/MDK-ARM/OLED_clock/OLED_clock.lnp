--cpu Cortex-M3
"oled_clock\startup_stm32f103xe.o"
"oled_clock\main.o"
"oled_clock\gpio.o"
"oled_clock\spi.o"
"oled_clock\tim.o"
"oled_clock\stm32f1xx_it.o"
"oled_clock\stm32f1xx_hal_msp.o"
"oled_clock\stm32f1xx_hal_gpio_ex.o"
"oled_clock\stm32f1xx_hal_spi.o"
"oled_clock\stm32f1xx_hal.o"
"oled_clock\stm32f1xx_hal_rcc.o"
"oled_clock\stm32f1xx_hal_rcc_ex.o"
"oled_clock\stm32f1xx_hal_gpio.o"
"oled_clock\stm32f1xx_hal_dma.o"
"oled_clock\stm32f1xx_hal_cortex.o"
"oled_clock\stm32f1xx_hal_pwr.o"
"oled_clock\stm32f1xx_hal_flash.o"
"oled_clock\stm32f1xx_hal_flash_ex.o"
"oled_clock\stm32f1xx_hal_exti.o"
"oled_clock\stm32f1xx_hal_tim.o"
"oled_clock\stm32f1xx_hal_tim_ex.o"
"oled_clock\system_stm32f1xx.o"
"oled_clock\sh1106oled.o"
"oled_clock\sh1106oledfont.o"
--library_type=microlib --strict --scatter "OLED_clock\OLED_clock.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "OLED_clock.map" -o OLED_clock\OLED_clock.axf